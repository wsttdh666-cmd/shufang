<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 不少小说站的链接还是 http:// 开头的，不放行的话站内浏览器一点就打不开 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
